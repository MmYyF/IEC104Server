<?xml version="1.0" encoding="utf-8"?>
<!--
  win-x64 发布配置：单文件 / 自包含 / 压缩 / 不带 pdb。

  为什么要有这个文件：
  这些参数以前只写在 build.bat 的命令行里。接上 GitHub Actions 之后，
  命令行会变成第二份定义——本地打包和 CI 出的包只要有一处不一致，
  用户装上就会遇到"这台机器能跑、那台不能"这种最难查的问题。
  现在两边都写 -p:PublishProfile=win-x64，参数以这个文件为准。

  DebugType=None：不生成 pdb。发出去的目录只允许一个 exe
  （见 界面设计规范.md 第八节"发布"）。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>None</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 发布目录只允许一个 exe。
         DebugType 只作用在入口项目上，被引用的 IEC104.Core / IEC104.Simulator
         仍会各自产出 pdb，并被一并复制到输出目录（实测冒出来两个）。
         这条把所有引用项目的附属文件（.pdb / .xml）挡在发布目录之外。 -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
</Project>
