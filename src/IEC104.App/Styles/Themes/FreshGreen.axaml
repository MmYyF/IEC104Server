<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Fresh Green 主题
    纯白清新绿：白底 + 工业绿点缀，几乎没有大面积着色，长时间盯屏最省眼。

    本文件由 gen_themes.py 生成，各套主题的键集合必须完全一致（当前 6 套）。
    新增主题：改脚本里的 THEMES 再重跑，别手改这里。
  -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFF" />   <!-- 窗口底色（最底层） -->
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />   <!-- 面板 / 卡片 / 表格行 -->
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F5FAF6" />   <!-- 次级面（表头、分组标题条） -->
  <SolidColorBrush x:Key="ToolbarBrush" Color="#FFFFFF" />   <!-- 菜单栏 / 工具条 / 状态栏 -->
  <SolidColorBrush x:Key="BorderLineBrush" Color="#E1E9E3" />   <!-- 分隔线、面板描边 -->
  <SolidColorBrush x:Key="DividerBrush" Color="#E8EEE9" />   <!-- 更淡的分隔线 -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#25352D" />   <!-- 正文 -->
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#66766C" />   <!-- 次要说明 / 表头 / 计数 -->
  <SolidColorBrush x:Key="TextDisabledBrush" Color="#9BA69E" />   <!-- 禁用 -->
  <SolidColorBrush x:Key="MenuIconBrush" Color="#517B62" />   <!-- 菜单线条图标（次要色压向主色一档，抗锯齿后仍清楚） -->
  <SolidColorBrush x:Key="PrimaryBrush" Color="#20864A" />   <!-- 主色（强调、启动、选中边） -->
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1B7A44" />   <!-- 主色悬停 -->
  <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#17683A" />   <!-- 主色按下 -->
  <SolidColorBrush x:Key="PrimarySoftBrush" Color="#E0F3E6" />   <!-- 主色浅底（选中块、悬停块、徽标底） -->
  <SolidColorBrush x:Key="PrimarySoftTextBrush" Color="#186B3B" />   <!-- 浅底上的文字（必须与 PrimarySoft 对比足够） -->
  <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />   <!-- 主色实心上的文字/图标 -->
  <SolidColorBrush x:Key="HoverBrush" Color="#EDF8F0" />   <!-- 通用悬停底 -->
  <SolidColorBrush x:Key="SelectionBrush" Color="#E0F3E6" />   <!-- 列表选中底 -->
  <SolidColorBrush x:Key="SelectionTextBrush" Color="#186B3B" />   <!-- 列表选中文字 -->
  <SolidColorBrush x:Key="RowHoverBrush" Color="#EDF8F0" />   <!-- 表格行悬停 -->
  <SolidColorBrush x:Key="RowSelectedBrush" Color="#E0F3E6" />   <!-- 表格行选中 -->
  <SolidColorBrush x:Key="RowTextBrush" Color="#25352D" />   <!-- 表格行文字（悬停/选中后必须仍可读） -->
  <SolidColorBrush x:Key="GridRowAltBrush" Color="#F7FBF8" />   <!-- 表格隔行底色 -->
  <SolidColorBrush x:Key="SuccessBrush" Color="#218449" />   <!-- 正常 / 已连接 -->
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E3F5E9" />   <!-- 正常态浅底 -->
  <SolidColorBrush x:Key="SuccessTextBrush" Color="#176E3D" />   <!-- 正常态浅底上的文字 -->
  <SolidColorBrush x:Key="WarningBrush" Color="#B77912" />   <!-- 警告 / 监听中 -->
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF2D6" />   <!-- 警告态浅底 -->
  <SolidColorBrush x:Key="WarningTextBrush" Color="#7A4E00" />   <!-- 警告态浅底上的文字 -->
  <SolidColorBrush x:Key="DangerBrush" Color="#CC3A3A" />   <!-- 错误 / 停止 / 删除 -->
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#FCE8E8" />   <!-- 错误态浅底 -->
  <SolidColorBrush x:Key="DangerTextBrush" Color="#A32020" />   <!-- 错误态浅底上的文字 -->
  <SolidColorBrush x:Key="ValueOnBrush" Color="#218449" />   <!-- 值：合 / 有电 -->
  <SolidColorBrush x:Key="ValueOffBrush" Color="#64748B" />   <!-- 值：分 / 无电 -->
  <SolidColorBrush x:Key="ValueMidBrush" Color="#94620E" />   <!-- 值：中间态 -->
  <SolidColorBrush x:Key="ValueBadBrush" Color="#C0392B" />   <!-- 值：不确定 -->
  <SolidColorBrush x:Key="ValueNeutralBrush" Color="#25352D" />   <!-- 值：模拟量中性色 -->
  <SolidColorBrush x:Key="QualityOkBgBrush" Color="#E3F5E9" />   <!-- 品质徽标：正常底 -->
  <SolidColorBrush x:Key="QualityOkFgBrush" Color="#176E3D" />   <!-- 品质徽标：正常字 -->
  <SolidColorBrush x:Key="QualityWarnBgBrush" Color="#FFF2D6" />   <!-- 品质徽标：警告底 -->
  <SolidColorBrush x:Key="QualityWarnFgBrush" Color="#7A4E00" />   <!-- 品质徽标：警告字 -->
  <SolidColorBrush x:Key="QualityBadBgBrush" Color="#FCE8E8" />   <!-- 品质徽标：异常底 -->
  <SolidColorBrush x:Key="QualityBadFgBrush" Color="#A32020" />   <!-- 品质徽标：异常字 -->
</ResourceDictionary>
