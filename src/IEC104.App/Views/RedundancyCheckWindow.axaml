<views:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:IEC104.App.Views"
        x:Class="IEC104.App.Views.RedundancyCheckWindow"
        Title="冗余校验计算"
        Icon="/Assets/app.ico"
        Width="720" Height="520"
        WindowStartupLocation="CenterOwner">

  <!--
    行定义原为 "Auto,Auto,4,Auto,*"，却把“计算结果”标题放进了第 2 行
    —— 那是个 4px 的间隔行，标题因此被裁成一条缝。
    改为三行：输入区 / 标题 / 结果（*） 撑满剩余高度。
  -->
  <Grid RowDefinitions="Auto,Auto,*" Margin="14">
    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock Text="输入（十六进制字节）" FontWeight="SemiBold" />
      <TextBox x:Name="InputBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap"
               FontFamily="Consolas, monospace" Watermark="例如：01 03 00 00 00 0A" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="计算" Classes="primary" Width="90" Click="OnComputeClick" />
        <Button Content="清空" Width="80" Click="OnClearClick" />
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Classes="hint" />
      </StackPanel>
    </StackPanel>

    <TextBlock Grid.Row="1" Text="计算结果" FontWeight="SemiBold" Margin="0,12,0,6" />

    <TextBox Grid.Row="2" x:Name="OutputBox" IsReadOnly="True" AcceptsReturn="True"
             TextWrapping="NoWrap" FontFamily="Consolas, monospace" Background="#FAFBFC" />
  </Grid>
</views:DialogWindow>
