<views:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:IEC104.App.Views"
        x:Class="IEC104.App.Views.InitDataWindow"
        Title="初始化数据（批量生成信息对象）"
        Icon="/Assets/app.ico"
        Width="920" Height="560"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14">

    <Border Grid.Row="0" Classes="panel" Padding="10,8">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="{Binding TargetText}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <views:HintIcon Tip="按类型批量铺初始点表：给定起始点号、数量、命名前缀、初值和步进。点号已被占用的一律跳过，不会覆盖原点。" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" Margin="0,10,0,6">
      <TextBlock Grid.Column="0" Text="勾选要生成的行，然后点“开始生成”。" Classes="hint"
                 VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="按现有点号接续" Width="130" Margin="12,0,0,0"
              Click="OnContinueClick" ToolTip.Tip="把勾选行的起始点号排在当前最大点号之后，避免撞号" />
      <TextBlock Grid.Column="2" Text="点号被占用的行会自动跳过。" Classes="hint"
                 VerticalAlignment="Center" Margin="12,0,0,0" />
    </Grid>

    <Border Grid.Row="2" Classes="panel">
      <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                CanUserSortColumns="False" CanUserReorderColumns="False">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="生成" Binding="{Binding Enabled, Mode=TwoWay}" Width="60" />
          <DataGridTextColumn Header="ASDU 类型" Binding="{Binding TypeName}" Width="200" IsReadOnly="True" />
          <DataGridTextColumn Header="起始点号" Binding="{Binding StartAddress, Mode=TwoWay}" Width="110" />
          <DataGridTextColumn Header="数量" Binding="{Binding Count, Mode=TwoWay}" Width="80" />
          <DataGridTextColumn Header="点号范围" Binding="{Binding RangeText}" Width="140" IsReadOnly="True" />
          <DataGridTextColumn Header="命名前缀" Binding="{Binding NamePrefix, Mode=TwoWay}" Width="*" />
          <DataGridTextColumn Header="初值" Binding="{Binding StartValue, Mode=TwoWay}" Width="100" />
          <DataGridTextColumn Header="步进" Binding="{Binding Step, Mode=TwoWay}" Width="100" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
      <TextBlock Grid.Column="0" Text="{Binding StatusText}" Classes="hint" VerticalAlignment="Center"
                 TextWrapping="Wrap" />
      <Button Grid.Column="1" Content="开始生成" Width="110" Classes="primary"
              Click="OnGenerateClick" Margin="0,0,8,0" />
      <Button Grid.Column="2" Content="关闭" Width="88" Click="OnCloseClick" />
    </Grid>
  </Grid>
</views:DialogWindow>
