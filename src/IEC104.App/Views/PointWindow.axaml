<views:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:IEC104.App.Views"
        x:Class="IEC104.App.Views.PointWindow"
        Title="信息对象配置"
        Icon="/Assets/app.ico"
        Width="480" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <Grid RowDefinitions="*,Auto" Margin="16">
    <StackPanel Spacing="10">

      <TextBlock Text="基本信息" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
      <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="信息对象地址" VerticalAlignment="Center" />
        <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding ObjectAddress, Mode=TwoWay}"
                       Minimum="1" Maximum="16777215" Increment="1" FormatString="0" Margin="0,4" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="名称" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" Margin="0,4" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="ASDU 类型" VerticalAlignment="Center" />
        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4"
                  ItemsSource="{Binding AvailableTypes}"
                  SelectedItem="{Binding Type, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Code}" Width="110" FontFamily="Consolas, monospace" />
                <TextBlock Text="{Binding DisplayName}" />
                <TextBlock Text="{Binding Category}" Classes="hint" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>

      <Separator />

      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="当前值" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"
                   VerticalAlignment="Center" />
        <views:HintIcon Tip="遥信建议填 0/1（双点用 1=分、2=合）；遥测填工程值；档位与累计量（遥脉）填整数。修改后若通道已启动，会立即自发上送（COT=3）。" />
      </StackPanel>
      <Grid ColumnDefinitions="110,*" RowDefinitions="Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="值" VerticalAlignment="Center" />
        <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding Value, Mode=TwoWay}"
                       Increment="1" FormatString="0.###" Margin="0,4" />
      </Grid>

      <Separator />

      <TextBlock Text="品质描述词（QDS）" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
      <StackPanel Spacing="4">
        <CheckBox Content="IV  无效（该值不可信，自动化不应参与判断）" IsChecked="{Binding IsInvalid, Mode=TwoWay}" />
        <CheckBox Content="BL  封锁（值被闭锁，不再刷新）" IsChecked="{Binding IsBlocked, Mode=TwoWay}" />
        <CheckBox Content="SB  取代（人工置数，非实测值）" IsChecked="{Binding IsSubstituted, Mode=TwoWay}" />
      </StackPanel>

      <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="取消" Width="88" Click="OnCancelClick" />
      <Button Content="确定" Width="88" Classes="primary" Click="OnOkClick" />
    </StackPanel>
  </Grid>
</views:DialogWindow>
