<views:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:IEC104.App.Views"
        x:Class="IEC104.App.Views.AsduTypeWindow"
        Title="{Binding Title}"
        Icon="/Assets/app.ico"
        Width="560" Height="600"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <!-- 新增/编辑自定义 ASDU 类型。
       表单的顺序是"先定身份（类型号/代号）、再定含义（中文名/分类）、最后定字节布局（格式/时标）"，
       和实际排查顺序一致：看到报文先认类型号，再看载荷长度。 -->
  <Grid RowDefinitions="*,Auto" Margin="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10">

        <TextBlock Text="类型标识" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto">
          <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4"
                      VerticalAlignment="Center">
            <TextBlock Text="类型号" VerticalAlignment="Center" />
            <views:HintIcon Tip="类型号就是报文首字节。规约里现成的号（如 8 = M_BO_TA_1）会自动带出代号与格式；项目自己约定的号（如 200）请自己起代号。" />
          </StackPanel>
          <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4" Text="{Binding TypeNumberText, Mode=TwoWay}"
                   Watermark="1 - 255，可填 200 或 0xC8"
                   IsEnabled="{Binding CanEditIdentity}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="规约代号" VerticalAlignment="Center" />
          <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding Code, Mode=TwoWay}"
                   IsEnabled="{Binding CanEditIdentity}" />
        </Grid>
        <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding TypeNumberHint}" />

        <Separator />

        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="含义" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"
                     VerticalAlignment="Center" />
          <views:HintIcon Tip="中文名会直接出现在点表的「ASDU 类型」列和页签上，别用代号当名字。分类决定它落在哪个页签：遥信 / 遥测 / 遥控 / 遥脉，都不属于的选「其他」（例如比特串、初始化结束）。" />
        </StackPanel>
        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="中文名" VerticalAlignment="Center" />
          <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4" Text="{Binding DisplayName, Mode=TwoWay}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="分类" VerticalAlignment="Center" />
          <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4"
                    ItemsSource="{Binding CategoryOptions}"
                    SelectedIndex="{Binding CategoryIndex, Mode=TwoWay}" />
        </Grid>

        <Separator />

        <TextBlock Text="编码格式" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="信息元素" VerticalAlignment="Center" />
          <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,4"
                    ItemsSource="{Binding FormatOptions}"
                    SelectedIndex="{Binding FormatIndex, Mode=TwoWay}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="时标" VerticalAlignment="Center" />
          <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4"
                    ItemsSource="{Binding TimeTagOptions}"
                    SelectedIndex="{Binding TimeTagIndex, Mode=TwoWay}" />
        </Grid>

        <!-- 长度预览：这两个下拉决定了报文的字节布局，选错了帧就是错的。
             直接把"发出去多少字节"算给用户看，比写十行说明都管用。 -->
        <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="6" Padding="10,8">
          <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" FontSize="12"
                     Foreground="{DynamicResource PrimarySoftTextBrush}" />
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="取消" Width="88" Click="OnCancelClick" />
      <Button Content="确定" Width="88" Classes="primary" Click="OnOkClick" />
    </StackPanel>
  </Grid>
</views:DialogWindow>
