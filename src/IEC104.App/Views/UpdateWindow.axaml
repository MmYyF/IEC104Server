<views:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:IEC104.App.Views"
        x:Class="IEC104.App.Views.UpdateWindow"
        Title="检查更新"
        Icon="/Assets/app.ico"
        Width="640" Height="560"
        WindowStartupLocation="CenterOwner">

  <!-- 行：版本对比 / 这一版标题 / 更新说明(*) / 进度 / 底部按钮。
       说明区占 *,可滚；按钮固定在最下面一行,小屏也点得到(见界面设计规范)。 -->
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="14">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{Binding CurrentVersionText}" FontWeight="SemiBold"
                 VerticalAlignment="Center" />
      <TextBlock Text="→" Classes="hint" VerticalAlignment="Center" />
      <TextBlock Text="{Binding LatestVersionText}" FontWeight="SemiBold"
                 VerticalAlignment="Center" />
      <views:HintIcon Tip="更新包只从项目的发布页下载，下完先用 SHA256 校验：对得上才替换，对不上就放弃。替换时旧文件先改名备份，写入失败会自动恢复，不会把软件弄坏。想手动升级也行——下载新 exe 覆盖旧的即可，工程和设置都不受影响。" />
      <TextBlock Text="{Binding SourceText}" Classes="hint" VerticalAlignment="Center"
                 Margin="6,0,0,0" />
      <TextBlock Text="{Binding DateText}" Classes="hint" VerticalAlignment="Center" />
    </StackPanel>

    <TextBlock Grid.Row="1" Text="{Binding TitleText}" FontWeight="SemiBold"
               TextWrapping="Wrap" Margin="0,10,0,0" />

    <Border Grid.Row="2" Classes="panel" Margin="0,10,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
        <ItemsControl ItemsSource="{Binding Notes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Text="·" Margin="0,0,6,0"
                           Foreground="{DynamicResource PrimaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <ProgressBar Grid.Row="3" Minimum="0" Maximum="100" Height="6"
                 Value="{Binding ProgressValue}"
                 IsVisible="{Binding ShowProgress}" Margin="0,10,0,0" />

    <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,12,0,0">
      <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{Binding StatusText}" Classes="hint" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}"
                   IsVisible="{Binding HasError}" />
      </StackPanel>

      <Button Grid.Column="1" Content="查看发布页" Width="100" Margin="0,0,8,0"
              Command="{Binding OpenReleasePageCommand}" />
      <Button Grid.Column="2" Content="{Binding DownloadButtonText}" Width="112"
              Classes="primary" Margin="0,0,8,0"
              Command="{Binding DownloadCommand}" />
      <Button Grid.Column="3" Content="关闭" Width="88" Click="OnCloseClick" />
    </Grid>
  </Grid>
</views:DialogWindow>
