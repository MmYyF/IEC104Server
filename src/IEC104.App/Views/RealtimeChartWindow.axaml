<views:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:IEC104.App.Views"
        xmlns:controls="clr-namespace:IEC104.App.Controls"
        x:Class="IEC104.App.Views.RealtimeChartWindow"
        Title="实时曲线"
        Icon="/Assets/app.ico"
        Width="1000" Height="640"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="Auto,*,Auto" Margin="14">

    <!-- 工具行 -->
    <Border Grid.Row="0" Classes="panel" Padding="10,8">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="{Binding StartButtonText}" Classes="primary" Width="110"
                Click="OnToggleClick" />
        <Button Content="清空曲线" Width="96" Click="OnClearClick" />
        <TextBlock Text="采样间隔(ms)" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding IntervalMs, Mode=TwoWay}" Width="130"
                       Minimum="100" Maximum="10000" Increment="100" FormatString="0"
                       VerticalAlignment="Center" />
        <TextBlock Text="勾选左侧点位后开始采样。" Classes="hint" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="300,4,*" Margin="0,10,0,0">

      <!-- 点位勾选列表 -->
      <Border Grid.Column="0" Classes="panel">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Classes="panelTitle" Text="选择要绘制的点位" />
          <ListBox Grid.Row="1" ItemsSource="{Binding Items}" Background="Transparent"
                   BorderThickness="0" SelectionMode="Single">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2">
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                            Click="OnItemCheckClick" Padding="0" MinWidth="24" />
                  <Border Grid.Column="1" Width="4" Height="16" CornerRadius="2"
                          Background="{Binding Brush}"
                          Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding DisplayText}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

      <!-- 曲线图 -->
      <Border Grid.Column="2" Classes="panel" Padding="4">
        <controls:LineChart x:Name="Chart" Series="{Binding Series}" MaxPoints="120" />
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" Text="{Binding StatusText}" Classes="hint" Margin="0,8,0,0" />
  </Grid>
</views:DialogWindow>
