<views:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:IEC104.App.Views"
        x:Class="IEC104.App.Views.IpManagerWindow"
        Title="IP 地址管理"
        Icon="/Assets/app.ico"
        Width="1000" Height="660"
        WindowStartupLocation="CenterOwner">

  <!-- 行定义：提示 / 主体(*) / 底部按钮。内容区可滚，按钮在固定的 Auto 行，
       1366×768 和 1080p@150% 下都点得到（见界面设计规范）。 -->
  <Grid RowDefinitions="Auto,*,Auto" Margin="14">

    <!-- 顶部一行：名称 + 悬停说明 + 权限状态。
         原来这里是三段连续小字（标题、为什么需要加 IP、只删得到什么），
         一进窗口先读五行说明，真正要干的事反而被压到下面。 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
      <TextBlock Text="本机网卡与 IPv4" FontWeight="SemiBold" VerticalAlignment="Center" />
      <views:HintIcon Tip="仿真从站要先让本机真的拥有那个 IP：主站按 IP 找装置，地址不在本机时通道会报 10049。这里只删得掉本工具自己加过的地址；系统原有的和 DHCP 拿到的一律只读。" />
      <TextBlock Text="{Binding ElevationText}" Classes="hint" VerticalAlignment="Center"
                 Margin="10,0,0,0" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="320,10,*" Margin="0,12,0,0">

      <!-- 左：网卡列表 -->
      <Border Grid.Column="0" Classes="panel">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Grid.Row="0" Text="网卡" FontWeight="SemiBold" Margin="10,8,10,6" />

          <ListBox Grid.Row="1" x:Name="NicList"
                   ItemsSource="{Binding Nics}"
                   SelectedItem="{Binding SelectedNic, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2" Margin="0,4">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SummaryText}" Classes="hint" />
                  <TextBlock Text="{Binding StatusText}" Classes="hint" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="2" Spacing="6" Margin="10,8,10,10">
            <TextBlock Text="{Binding NicDetailText}" Classes="hint" TextWrapping="Wrap" />
            <Button Content="设为默认网卡" Command="{Binding SetDefaultNicCommand}"
                    HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 右：该网卡的地址 -->
      <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Classes="panel" Padding="12,10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="地址" VerticalAlignment="Center" />
            <TextBox x:Name="NewAddressBox" Text="{Binding NewAddress, Mode=TwoWay}"
                     Width="150" Watermark="192.168.1.10" />
            <TextBlock Text="掩码" VerticalAlignment="Center" />
            <TextBox Text="{Binding NewMask, Mode=TwoWay}" Width="126" />
            <TextBlock Text="{Binding MaskHintText}" Classes="hint" VerticalAlignment="Center"
                       MinWidth="66" />
            <Button Content="添加" Classes="primary" Width="72"
                    Command="{Binding AddCommand}" />
            <views:HintIcon Tip="一个网卡可以挂多个地址，主站从哪个网段来都能连。地址若已在任何一块网卡上，会跳过不重复添加。要一次加一串，用右下角的「批量添加」。" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="panel" Margin="0,10,0,0">
          <DataGrid x:Name="AddressGrid" ItemsSource="{Binding Addresses}"
                    SelectedItem="{Binding SelectedAddress, Mode=TwoWay}"
                    AutoGenerateColumns="False" CanUserSortColumns="False"
                    CanUserReorderColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="160" />
              <DataGridTextColumn Header="前缀" Binding="{Binding PrefixLength}" Width="70" />
              <DataGridTextColumn Header="掩码" Binding="{Binding MaskText}" Width="150" />
              <DataGridTextColumn Header="来源" Binding="{Binding SourceText}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,10,0,0">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{Binding ManagedSummaryText}" Classes="hint" VerticalAlignment="Center" />
            <views:HintIcon Tip="只有“来源 = 本工具”的地址能删；系统原有的、DHCP 拿到的一律保留，避免误伤现场的正常配置。" />
          </StackPanel>
          <Button Grid.Column="1" Content="批量添加…" Width="96" Margin="0,0,8,0"
                  Click="OnBatchAddClick"
                  ToolTip.Tip="按起始地址和步长一次加一串（整批只弹一次授权）" />
          <Button Grid.Column="2" Content="删除选中" Width="100" Margin="0,0,8,0"
                  Command="{Binding DeleteCommand}" />
          <Button Grid.Column="3" Content="清理本工具加的" Width="130"
                  Command="{Binding CleanupCommand}"
                  ToolTip.Tip="把本工具添加过的地址全部删掉（账本里的都删）" />
        </Grid>
      </Grid>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
      <TextBlock Grid.Column="0" Text="{Binding StatusText}" Classes="hint"
                 VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1" Content="刷新" Width="88" Margin="0,0,8,0"
              Command="{Binding RefreshCommand}" />
      <Button Grid.Column="2" Content="关闭" Width="88" Click="OnCloseClick" />
    </Grid>
  </Grid>
</views:DialogWindow>
